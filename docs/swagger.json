    "/auth/confirmoauth": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "confirm Auth by Google OAuth Code",
        "operationId": "confirmOAuth",
        "description": "Sign Up or Sign In with Google OAuth code from recently received URL",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
